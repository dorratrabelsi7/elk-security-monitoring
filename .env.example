# Copier ce fichier en .env puis remplacer chaque "changeme" par un vrai mot de passe.
# Le fichier .env ne doit JAMAIS être versionné (il est dans .gitignore).
# Conseil : mots de passe en lettres et chiffres uniquement (évite les problèmes avec $ " ' dans Docker).

# Versions d'images figées
ELASTIC_VERSION=8.15.0
MONGO_VERSION=7.0
REDIS_VERSION=7.2

# Elasticsearch (compte "elastic") et Kibana (compte "kibana_system")
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme
# Clé de chiffrement Kibana : au moins 32 caractères
KIBANA_ENCRYPTION_KEY=changemechangemechangemechangeme

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=changeme

# Redis
REDIS_PASSWORD=changeme

# Application web (utilisé à partir de T22)
APP_SECRET_KEY=changeme
MAX_UPLOAD_MB=100
